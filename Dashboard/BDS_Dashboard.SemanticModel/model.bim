        "measures": [
          {
            "name": "Tổng Doanh Thu",
            "expression": "SUM(fact_GiaoDich[Doanh thu ghi nhận (trđ)])",
            "formatString": "#,0.0"
          },
          {
            "name": "Số Giao Dịch",
            "expression": "COUNTROWS(fact_GiaoDich)",
            "formatString": "#,0"
          },
          {
            "name": "Số GD Hiệu Lực",
            "expression": "CALCULATE(COUNTROWS(fact_GiaoDich), fact_GiaoDich[Trạng thái] <> \"Huỷ cọc\")",
            "formatString": "#,0"
          },
          {
            "name": "Tổng Diện Tích",
            "expression": "SUM(fact_GiaoDich[Diện tích (m²)])",
            "formatString": "#,0.0"
          },
          {
            "name": "Tỷ Lệ Huỷ Cọc",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(fact_GiaoDich), fact_GiaoDich[Trạng thái] = \"Huỷ cọc\"), COUNTROWS(fact_GiaoDich), 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Tổng Giá Trị HĐ",
            "expression": "SUM(fact_GiaoDich[Giá trị hợp đồng (trđ)])",
            "formatString": "#,0.0"
          },
          {
            "name": "Tỷ Lệ Huỷ",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(fact_GiaoDich), fact_GiaoDich[Trạng thái] = \"Huỷ cọc\"), COUNTROWS(fact_GiaoDich), 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Doanh Thu TB/GD",
            "expression": "DIVIDE([Tổng Doanh Thu], [Số GD Hiệu Lực], 0)",
            "formatString": "#,0.0"
          },
          {
            "name": "Đơn Giá TB",
            "expression": "AVERAGE(fact_GiaoDich[Đơn giá (trđ/m²)])",
            "formatString": "#,0.0"
          },
          {
            "name": "Chiết Khấu TB",
            "expression": "AVERAGE(fact_GiaoDich[Chiết khấu (%)])",
            "formatString": "0.0%"
          },
          {
            "name": "Tổng Kế Hoạch",
            "expression": "SUM(dim_KeHoach[Kế hoạch 2026 (trđ)])",
            "formatString": "#,0"
          },
          {
            "name": "% Hoàn Thành KH",
            "expression": "DIVIDE([Tổng Doanh Thu], [Tổng Kế Hoạch], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Số GD Huỷ Cọc",
            "expression": "CALCULATE(COUNTROWS(fact_GiaoDich), fact_GiaoDich[Trạng thái] = \"Huỷ cọc\")",
            "formatString": "#,0"
          },
          {
            "name": "Số GD Ký HĐMB",
            "expression": "CALCULATE(COUNTROWS(fact_GiaoDich), fact_GiaoDich[Trạng thái] = \"Đã ký HĐMB\")",
            "formatString": "#,0"
          },
          {
            "name": "% Ký HĐMB",
            "expression": "DIVIDE([Số GD Ký HĐMB], [Số Giao Dịch], 0)",
            "formatString": "0.0%"
          },
          {
            "name": "Doanh Thu (tỷ)",
            "expression": "DIVIDE(SUM(fact_GiaoDich[Doanh thu ghi nhận (trđ)]), 1000, 0)",
            "formatString": "#,0.0"
          },
          {
            "name": "Kế Hoạch (tỷ)",
            "expression": "DIVIDE([Tổng Kế Hoạch], 1000, 0)",
            "formatString": "#,0.0"
          }
        ],
        "partitions": [
          {
            "name": "fact_GiaoDich",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    FilePath = \"d:/Training/2026-08_powerbi_thanh/Dashboard/fact_GiaoDich.csv\",",
                "    Source = Csv.Document(File.Contents(FilePath), [Delimiter=\",\", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {",
                "        {\"Mã giao dịch\", type text}, {\"Ngày giờ bán\", type datetime}, {\"Tháng\", type text},",
                "        {\"Dự án\", type text}, {\"Loại hình BĐS\", type text}, {\"Khu vực\", type text},",
                "        {\"Kênh bán\", type text}, {\"Nhân viên sales\", type text},",
                "        {\"Diện tích (m²)\", type number}, {\"Đơn giá (trđ/m²)\", type number},",
                "        {\"Giá trị hợp đồng (trđ)\", type number}, {\"Chiết khấu (%)\", type number},",
                "        {\"Trạng thái\", type text}, {\"Doanh thu ghi nhận (trđ)\", type number}",
                "    }),",
                "    AddDateOnly = Table.AddColumn(ChangedTypes, \"DateOnly\", each Date.From([Ngày giờ bán]), type date),",
                "    AddHour = Table.AddColumn(AddDateOnly, \"Giờ bán\", each Time.Hour(DateTime.Time([Ngày giờ bán])), Int64.Type),",
                "    AddDiscountAmt = Table.AddColumn(AddHour, \"Số tiền CK (trđ)\", each [#\"Giá trị hợp đồng (trđ)\"] * [#\"Chiết khấu (%)\"], type number),",
                "    AddPriceGroup = Table.AddColumn(AddDiscountAmt, \"Nhóm giá trị\", each",
                "        if [#\"Giá trị hợp đồng (trđ)\"] < 3000 then \"< 3 tỷ\"",
                "        else if [#\"Giá trị hợp đồng (trđ)\"] < 5000 then \"3-5 tỷ\"",
                "        else if [#\"Giá trị hợp đồng (trđ)\"] < 10000 then \"5-10 tỷ\"",
                "        else if [#\"Giá trị hợp đồng (trđ)\"] < 20000 then \"10-20 tỷ\"",
                "        else \">= 20 tỷ\", type text),",
                "    AddRevBillion = Table.AddColumn(AddPriceGroup, \"Doanh thu (tỷ)\", each [#\"Doanh thu ghi nhận (trđ)\"] / 1000, type number),",
                "    AddContractBillion = Table.AddColumn(AddRevBillion, \"Giá trị HĐ (tỷ)\", each [#\"Giá trị hợp đồng (trđ)\"] / 1000, type number),",
                "    AddMonthSort = Table.AddColumn(AddContractBillion, \"Tháng Sort\", each",
                "        if [Tháng] = \"Tháng 1\" then 1 else if [Tháng] = \"Tháng 2\" then 2",
                "        else if [Tháng] = \"Tháng 3\" then 3 else if [Tháng] = \"Tháng 4\" then 4",
                "        else if [Tháng] = \"Tháng 5\" then 5 else if [Tháng] = \"Tháng 6\" then 6",
                "        else if [Tháng] = \"Tháng 7\" then 7 else if [Tháng] = \"Tháng 8\" then 8",
                "        else if [Tháng] = \"Tháng 9\" then 9 else if [Tháng] = \"Tháng 10\" then 10",
                "        else if [Tháng] = \"Tháng 11\" then 11 else 12, Int64.Type)",
                "in",
                "    AddMonthSort"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
