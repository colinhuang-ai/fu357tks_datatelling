                "let",
                "    FilePath = \"d:/Training/2026-08_powerbi_thanh/Dashboard/dim_Calendar.csv\",",
                "    Source = Csv.Document(File.Contents(FilePath), [Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {",
                "        {\"Date\", type date}, {\"Year\", Int64.Type}, {\"Month\", Int64.Type},",
                "        {\"MonthName\", type text}, {\"MonthNameVN\", type text},",
                "        {\"Quarter\", Int64.Type}, {\"QuarterName\", type text},",
                "        {\"DayOfWeek\", Int64.Type}, {\"DayNameVN\", type text},",
                "        {\"WeekOfYear\", Int64.Type}, {\"IsWeekend\", Int64.Type}",
                "    })",
                "in",
                "    ChangedTypes"
              ]
            }
