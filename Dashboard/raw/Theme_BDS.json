{
  "name": "BDS Dashboard 2026",
  "dataColors": [
    "#1B3A5C",
    "#D4A843",
    "#4472C4",
    "#ED7D31",
    "#5BAA6A",
    "#A5A5A5",
    "#FFC000",
    "#5B9BD5",
    "#70AD47",
    "#264478",
    "#9B59B6",
    "#E74C6F"
  ],
  "background": "#F2F2F2",
  "foreground": "#1B3A5C",
  "tableAccent": "#1B3A5C",
  "textClasses": {
    "callout": {
      "fontSize": 32,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B3A5C"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B3A5C"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B3A5C"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#333333"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": { "solid": { "color": "#D9D9D9" } },
            "show": true
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1B3A5C" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F2F2F2" } },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridHorizontal": true
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1B3A5C" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}
